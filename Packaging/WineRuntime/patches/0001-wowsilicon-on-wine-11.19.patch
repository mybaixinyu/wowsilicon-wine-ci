+static void pulse_system_device_notification(EDataFlow flow, BOOL clear)
+{
+    char token_buffer[sizeof(TOKEN_USER) + sizeof(SID) + sizeof(DWORD) * SID_MAX_SUB_AUTHORITIES];
+    static const char suffix[] = "\\Software\\Wine\\Drivers\\winecoreaudio.drv";
+    UNICODE_STRING input_name = RTL_CONSTANT_STRING(L"DefaultInput");
+    UNICODE_STRING output_name = RTL_CONSTANT_STRING(L"DefaultOutput");
+    UNICODE_STRING *value_name = flow == eCapture ? &input_name : &output_name;
+    TOKEN_USER *user = (TOKEN_USER *)token_buffer;
+    SID *sid;
+    unsigned long long authority = 0;
+    char path[512];
+    WCHAR pathW[512];
+    UNICODE_STRING key_name;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE key;
+    WCHAR empty = 0;
+    ULONG needed;
+    NTSTATUS status;
+    size_t i;
+    int added, length;
+
+    status = NtQueryInformationToken((HANDLE)~(ULONG_PTR)5, TokenUser, token_buffer,
+                                     sizeof(token_buffer), &needed);
+    if (status) goto done;
+    sid = user->User.Sid;
+
+    for (i = 0; i < sizeof(sid->IdentifierAuthority.Value); ++i)
+        authority = (authority << 8) | sid->IdentifierAuthority.Value[i];
+    length = snprintf(path, sizeof(path), "\\Registry\\User\\S-%u-%llu",
+                      sid->Revision, authority);
+    if (length <= 0 || (size_t)length >= sizeof(path))
+    {
+        status = STATUS_BUFFER_TOO_SMALL;
+        goto done;
+    }
+    for (i = 0; i < sid->SubAuthorityCount; ++i)
+    {
+        added = snprintf(path + length, sizeof(path) - length, "-%lu",
+                         (unsigned long)sid->SubAuthority[i]);
+        if (added < 0 || (size_t)added >= sizeof(path) - length)
+        {
+            status = STATUS_BUFFER_TOO_SMALL;
+            goto done;
+        }
+        length += added;
+    }
+    if ((size_t)length + sizeof(suffix) > sizeof(path))
+    {
+        status = STATUS_BUFFER_TOO_SMALL;
+        goto done;
+    }
+    memcpy(path + length, suffix, sizeof(suffix));
+    length += sizeof(suffix) - 1;
+    for (i = 0; i <= (size_t)length; ++i) pathW[i] = path[i];
+    key_name.Buffer = pathW;
+    key_name.Length = length * sizeof(WCHAR);
+    key_name.MaximumLength = (length + 1) * sizeof(WCHAR);
+
+    InitializeObjectAttributes(&attr, &key_name, OBJ_CASE_INSENSITIVE, NULL, NULL);
+    if (!(status = NtOpenKey(&key, KEY_SET_VALUE, &attr)))
+    {
+        if (clear) status = NtDeleteValueKey(key, value_name);
+        else status = NtSetValueKey(key, value_name, 0, REG_SZ, &empty, sizeof(empty));
+        NtClose(key);
+    }
+done:
+    TRACE("%s macOS system %s device notification, status %#x\n",
+          clear ? "Cleared" : "Pulsed", flow == eCapture ? "input" : "output",
+          (unsigned int)status);
+}
