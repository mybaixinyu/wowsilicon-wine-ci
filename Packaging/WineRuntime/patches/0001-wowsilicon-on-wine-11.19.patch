+static void ca_follow_system_device(struct coreaudio_stream *stream)
+{
+    AudioStreamBasicDescription new_desc, old_desc;
+    AudioConverterRef new_converter = NULL, old_converter;
+    AudioComponentInstance new_unit, old_unit;
+    AURenderCallbackStruct input;
+    AudioDeviceID new_id, old_id;
+    BYTE *new_buffer = NULL, *old_buffer;
+    UINT32 new_frames = 0, old_frames, old_offset, old_held;
+    HRESULT hr;
+    OSStatus sc;
+    BOOL verification_retry = FALSE;
+
+    if (stream->clear_system_device_pulse)
+    {
+        pulse_system_device_notification(stream->flow, TRUE);
+        stream->clear_system_device_pulse = FALSE;
+    }
+
+    new_id = get_default_device_id(stream->flow);
+    if (new_id == kAudioObjectUnknown) return;
+    if (new_id == stream->dev_id)
+    {
+        if (new_id == stream->verify_system_device)
+        {
+            if (++stream->verify_system_device_count < 12) return;
+            stream->verify_system_device = kAudioObjectUnknown;
+            stream->verify_system_device_count = 0;
+            verification_retry = TRUE;
+        }
+        else
+        {
+            stream->pending_system_device = kAudioObjectUnknown;
+            stream->pending_system_device_count = 0;
+            return;
+        }
+    }
+    if (!verification_retry && new_id != stream->pending_system_device)
+    {
+        stream->pending_system_device = new_id;
+        stream->pending_system_device_count = 1;
+        return;
+    }
+    if (!verification_retry)
+    {
+        if (++stream->pending_system_device_count < 4) return;
+        stream->pending_system_device_count = 0;
+    }
+
+    if (!(new_unit = get_audiounit(stream->flow, new_id))) return;
+    hr = ca_setup_audiounit(stream->flow, new_unit, stream->fmt, &new_desc, &new_converter);
+    if (FAILED(hr)) goto failed;
+
+    input.inputProcRefCon = stream;
+    if (stream->flow == eCapture)
+    {
+        input.inputProc = ca_capture_cb;
+        sc = AudioUnitSetProperty(new_unit, kAudioOutputUnitProperty_SetInputCallback,
+                                  kAudioUnitScope_Output, 1, &input, sizeof(input));
+        if (sc != noErr) goto failed;
+        new_frames = muldiv(stream->bufsize_frames, new_desc.mSampleRate,
+                            stream->fmt->nSamplesPerSec);
+        if (!(new_buffer = malloc(new_frames * stream->fmt->nBlockAlign)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto failed;
+        }
+    }
+    else
+    {
+        if (stream->spatial_unit)
+        {
+            sc = AudioUnitSetProperty(new_unit, kAudioUnitProperty_StreamFormat,
+                                      kAudioUnitScope_Input, 0, &stream->spatial_output_desc,
+                                      sizeof(stream->spatial_output_desc));
+            if (sc != noErr) goto failed;
+            input.inputProc = ca_spatial_render_cb;
+        }
+        else input.inputProc = ca_render_cb;
+        sc = AudioUnitSetProperty(new_unit, kAudioUnitProperty_SetRenderCallback,
+                                  kAudioUnitScope_Input, 0, &input, sizeof(input));
+        if (sc != noErr) goto failed;
+    }
+
+    sc = AudioUnitInitialize(new_unit);
+    if (sc != noErr) goto failed;
+
+    old_unit = stream->unit;
+    old_id = stream->dev_id;
+    old_desc = stream->dev_desc;
+    old_converter = stream->converter;
+    old_buffer = stream->cap_buffer;
+    old_frames = stream->cap_bufsize_frames;
+    old_offset = stream->cap_offs_frames;
+    old_held = stream->cap_held_frames;
+
+    AudioOutputUnitStop(old_unit);
+    stream->unit = new_unit;
+    stream->dev_id = new_id;
+    stream->dev_desc = new_desc;
+    if (stream->flow == eCapture)
+    {
+        stream->converter = new_converter;
+        stream->cap_buffer = new_buffer;
+        stream->cap_bufsize_frames = new_frames;
+        stream->cap_offs_frames = stream->cap_held_frames = 0;
+    }
+
+    sc = AudioOutputUnitStart(new_unit);
+    if (sc != noErr)
+    {
+        stream->unit = old_unit;
+        stream->dev_id = old_id;
+        stream->dev_desc = old_desc;
+        if (stream->flow == eCapture)
+        {
+            stream->converter = old_converter;
