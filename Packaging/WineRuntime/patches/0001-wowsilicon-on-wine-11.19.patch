+void DSOUND_DefaultDeviceChanged(IMMDevice *mmdevice, const GUID *guid)
+{
+    DirectSoundDevice *device;
+
+    AcquireSRWLockExclusive(&default_playback_devices_lock);
+    LIST_FOR_EACH_ENTRY(device, &default_playback_devices, DirectSoundDevice, default_entry) {
+        IMMDevice *old_mmdevice;
+        HRESULT hr;
+
+        if (IsEqualGUID(&device->guid, guid))
+            continue;
+
+        IMMDevice_AddRef(mmdevice);
+        AcquireSRWLockExclusive(&device->buffer_list_lock);
+        EnterCriticalSection(&device->mixlock);
+
+        old_mmdevice = device->mmdevice;
+        device->mmdevice = mmdevice;
+        hr = DSOUND_ReopenDevice(device, device->priolevel == DSSCL_WRITEPRIMARY);
+        if (SUCCEEDED(hr)) {
+            device->guid = *guid;
+            IMMDevice_Release(old_mmdevice);
+            TRACE("migrated default playback device to %s\n", debugstr_guid(guid));
+        } else {
+            device->mmdevice = old_mmdevice;
+            IMMDevice_Release(mmdevice);
+            WARN("failed to migrate default playback device: %08lx\n", hr);
+        }
+
+        LeaveCriticalSection(&device->mixlock);
+        ReleaseSRWLockExclusive(&device->buffer_list_lock);
+    }
+    ReleaseSRWLockExclusive(&default_playback_devices_lock);
+}
