+static enum spatial_audio_mode parse_spatial_audio_mode(const char *value,
+                                                        enum spatial_audio_mode fallback)
+{
+    size_t length;
+
+    if (!value) return fallback;
+    length = strcspn(value, "\r\n");
+    if (length == 3 && !strncmp(value, "off", length)) return SPATIAL_AUDIO_OFF;
+    if (length == 5 && !strncmp(value, "fixed", length)) return SPATIAL_AUDIO_FIXED;
+    return fallback;
+}
+
+static BOOL parse_normalize_audio(const char *value, BOOL fallback)
+{
+    size_t length;
+
+    if (!value) return fallback;
+    length = strcspn(value, "\r\n");
+    if ((length == 1 && value[0] == '1') || (length == 2 && !strncmp(value, "on", length)))
+        return TRUE;
+    if ((length == 1 && value[0] == '0') || (length == 3 && !strncmp(value, "off", length)))
+        return FALSE;
+    return fallback;
+}
+
+static char *get_wowsilicon_control_path(const char *environment, const char *name)
+{
+    static const char directory[] = "/Library/Application Support/WoWSilicon/";
+    const char *path = getenv(environment);
+    const char *home;
+    char *default_path;
+    size_t size;
+
+    if (path && *path) return strdup(path);
+    if (!(home = getenv("HOME")) || !*home) return NULL;
+    size = strlen(home) + sizeof(directory) - 1 + strlen(name) + 1;
+    if (!(default_path = malloc(size))) return NULL;
+    snprintf(default_path, size, "%s%s%s", home, directory, name);
+    return default_path;
+}
+
+static BOOL read_normalize_audio(const char *path, BOOL fallback)
+{
+    char buffer[32];
+    ssize_t count;
+    int fd;
+
+    if (!path || (fd = open(path, O_RDONLY)) == -1) return fallback;
+    count = read(fd, buffer, sizeof(buffer) - 1);
+    close(fd);
+    if (count <= 0) return fallback;
+    buffer[count] = 0;
+    return parse_normalize_audio(buffer, fallback);
+}
+
+static BOOL ca_apply_normalize_audio(struct coreaudio_stream *stream, BOOL enabled)
+{
+    stream->normalize_audio = enabled;
+    TRACE("Normalize Audio changed to %s\n", enabled ? "on" : "off");
+    return TRUE;
+}
+
+static void ca_setup_normalize_audio(struct coreaudio_stream *stream)
+{
+    stream->normalize_audio = parse_normalize_audio(getenv("WOWSILICON_NORMALIZE_AUDIO"), FALSE);
+    stream->normalize_gain = 1.0f;
+    stream->normalize_control_path = get_wowsilicon_control_path(
+            "WOWSILICON_NORMALIZE_AUDIO_CONTROL", "normalize-audio");
+    if (stream->normalize_control_path)
+        stream->normalize_audio = read_normalize_audio(stream->normalize_control_path,
+                                                       stream->normalize_audio);
+    TRACE("Normalize Audio initialized %s\n", stream->normalize_audio ? "on" : "off");
+}
+
+static enum spatial_audio_mode read_spatial_audio_mode(const char *path,
+                                                       enum spatial_audio_mode fallback)
+{
+    char buffer[32];
+    ssize_t count;
+    int fd;
+
+    if (!path || (fd = open(path, O_RDONLY)) == -1) return fallback;
+    count = read(fd, buffer, sizeof(buffer) - 1);
+    close(fd);
+    if (count <= 0) return fallback;
+    buffer[count] = 0;
+    return parse_spatial_audio_mode(buffer, fallback);
+}
+
+static const char *spatial_audio_mode_name(enum spatial_audio_mode mode)
+{
+    switch (mode)
+    {
+    case SPATIAL_AUDIO_OFF: return "off";
+    case SPATIAL_AUDIO_FIXED: return "fixed";
+    }
+    return "unknown";
+}
+
+static BOOL ca_apply_spatial_audio_mode(struct coreaudio_stream *stream,
+                                        enum spatial_audio_mode mode)
+{
+    UInt32 value = mode == SPATIAL_AUDIO_OFF ? kSpatialMixerSourceMode_Bypass
+                                              : kSpatialMixerSourceMode_AmbienceBed;
+    OSStatus sc;
+
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_SpatialMixerSourceMode,
+                              kAudioUnitScope_Input, 0, &value, sizeof(value));
+    if (sc != noErr)
+    {
+        WARN("Couldn't change spatial mixer source mode: %x\n", (int)sc);
+        return FALSE;
+    }
+
+    stream->spatial_mode = mode;
+    TRACE("Headphone spatialization changed to %s\n", spatial_audio_mode_name(mode));
+    return TRUE;
+}
